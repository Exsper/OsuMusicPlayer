<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>OsuMusicPlayer.Core.Tests</RootNamespace>
    <!-- xUnit1051（提示使用 TestContext 取消令牌）对本地同步测试没有实际意义。 -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OsuMusicPlayer.Core\OsuMusicPlayer.Core.csproj" />
    <ProjectReference Include="..\..\src\OsuMusicPlayer.Audio\OsuMusicPlayer.Audio.csproj" />
    <ProjectReference Include="..\..\tools\OsuMusicPlayer.SampleData\OsuMusicPlayer.SampleData.csproj" />
  </ItemGroup>

</Project>
